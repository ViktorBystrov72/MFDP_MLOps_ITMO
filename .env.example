# Hugging Face (опционально, кэш/загрузки моделей)
HF_TOKEN=

# LiteLLM — прокси к LLM (voting / arbiter)
LITELLM_API_KEY=
LITELLM_BASE_URL=http://litellm.prod.liris.team.corp

# Путь к репозиторию neolithic-ml (DVC-веса BGE / reranker)
NEOLITHIC_ML_REPO_PATH=/path/to/neolithic-ml

# Каскад матчинга: режим, пороги, полоса review
MATCH_CASCADE_MARGIN=0.05
MATCH_CASCADE_MODE=precision_first
MATCH_CASCADE_THRESHOLD=0.95
MATCH_REVIEW_BAND=0.08

# Эмбеддинги / reranker / torch.compile
MATCH_EMBEDDING_BACKEND=bge-cls
MATCH_TORCH_COMPILE=0
MATCH_USE_EMBEDDINGS=1
MATCH_USE_RERANKER=1

# LLM-слой каскада (модели, voting, лимиты)
MATCH_LLM_MAX_CANDIDATES=3
MATCH_LLM_MODEL=openai/gpt-5.4-mini
MATCH_LLM_MODELS=openai/gpt-5.4-mini,anthropic/claude-haiku-4.5,deepseek/deepseek-v3.2
MATCH_LLM_TEXT_LIMIT=800
MATCH_LLM_VOTING=1
MATCH_USE_LLM=1
